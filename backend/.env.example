# Copy to .env and fill in. Never commit .env.

# --- database (local MongoDB) ---------------------------------------------
MONGO_URL=mongodb://localhost:27017
MONGO_DB=excelclear

# --- auth -----------------------------------------------------------------
# Generate with:  python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# --- storage --------------------------------------------------------------
STORAGE_PATH=./storage
MAX_UPLOAD_MB=25
MAX_PDF_PAGES=20

# --- AI provider ----------------------------------------------------------
# local      = the bundled reader on this machine (offline, no cost, slowest)
# http       = a self-hosted GPU service (Modal, RunPod, a rented box)
# openrouter = a hosted vision model
AI_PROVIDER=local

# --- openrouter -----------------------------------------------------------
# Only read when AI_PROVIDER=openrouter. Get a key at openrouter.ai/keys.
# Never exposed to the browser: the page talks to this API, this API talks out.
OPENROUTER_API_KEY=
# Model ids at openrouter.ai/models. Ones ending in ":free" cost nothing but
# are rate limited and may queue — and, on a dense bilingual invoice, read it
# badly: a free model returned "Credii" for "Credit" and dropped a digit from
# every Arabic-Indic figure on the page. What the reader gets wrong here, no
# amount of work downstream can put right.
#
# Check the id against openrouter.ai/models before setting it. A model that has
# been retired is not a slow reader, it is a 404 — and a rejected request is not
# retried on the fallback models, so every job fails at once.
#
# scripts/compare_readers.py measures candidates on your own invoices, which
# beats any recommendation: no catalogue entry says how a model reads Arabic.
OPENROUTER_MODEL=qwen/qwen3.8-flash
# Tried in order, only when the model above is busy or out of credit. A second
# hosted model answers in seconds; the local reader takes minutes.
OPENROUTER_FALLBACK_MODELS=
# Room for a whole page transcribed as HTML. A dense export invoice — thirty
# priced rows across nine columns, plus its header boxes and its declarations —
# runs to many thousands of tokens, and set too low the answer stops mid-table.
# The reading is then refused rather than accepted half-finished, but a refusal
# still costs an attempt, so the ceiling is set well clear of the worst page.
OPENROUTER_MAX_TOKENS=24000
# Sent as HTTP-Referer for usage attribution. Not a credential.
OPENROUTER_SITE=
# Modal prints this URL on deploy. Leave empty while AI_PROVIDER=local.
AI_SERVICE_URL=
# Shared secret between this backend and the GPU service. Same value as the
# AI_SERVICE_KEY in the Modal secret. Never exposed to the browser.
AI_SERVICE_KEY=
AI_TIMEOUT_SECONDS=900
# Fall back to the local reader when the GPU service is unreachable.
AI_FALLBACK_LOCAL=true

# --- the reading pipeline -------------------------------------------------
# Ships in this repository at ../ocr_worker, so a fresh clone can process a
# document. Point this at the desktop tree (../../ExcelCleaner/ocr_worker) when
# you are working on both at once and want one copy rather than two.
WORKER_ROOT=../ocr_worker
JOB_CONCURRENCY=1

# --- api ------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173
DEBUG=false
